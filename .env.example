# App Configuration
APP_NAME="AI Software Engineer Agent"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# LLM Provider Configuration
DEFAULT_LLM_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-pro"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192

# Database
DATABASE_URL="sqlite+aiosqlite:///./data/agent_tasks.db"

# Workspace & Sandbox Configuration
WORKSPACES_ROOT="./temp_workspaces"
DOCKER_SANDBOX_IMAGE="python:3.12-slim"
SANDBOX_EXECUTION_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT="2g"
SANDBOX_CPU_LIMIT=2.0
REQUIRE_HUMAN_APPROVAL_FOR_DESTRUCTIVE_ACTIONS=true

# GitHub Integration (Optional for PR creation)
GITHUB_TOKEN=""
